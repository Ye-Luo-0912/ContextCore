{
  "version": 1,
  "description": "必测类别：每个类别必须有 >= minExecuted 条真实执行结果（executed = Passed + Failed）。executed == 0 即环境跳过（Docker 未就绪、过滤错误等），Evidence 失败。allowNotExecuted 为文档化已知 [Ignore] 测试名单（后缀匹配 testName），白名单外的 NotExecuted / Skipped 一律视为未声明的环境跳过并失败。",
  "categories": [
    {
      "job": "unit",
      "dir": "unit",
      "name": "unit",
      "filter": "TestCategory!=Integration&TestCategory!=Architecture&TestCategory!=Contract",
      "minExecuted": 1,
      "allowNotExecuted": [
        "R29H_AgentRunProcessRestartTests.Restart_Postgres_PersistentRecovery",
        "R29H_CanaryMultiInstanceWindowTests.MultiInstance_Postgres_PersistentAggregation",
        "R29H_LearningEventAcceptanceTests.DatasetSnapshot_HasCompleteness_AndLineageReport",
        "R29H_ModelActivationProductionTests.Production_Postgres_PersistentActivation"
      ]
    },
    {
      "job": "integration-postgres",
      "dir": "integration",
      "name": "integration",
      "filter": "TestCategory=Integration",
      "minExecuted": 1,
      "allowNotExecuted": []
    },
    {
      "job": "architecture",
      "dir": "architecture",
      "name": "architecture",
      "filter": "TestCategory=Architecture",
      "minExecuted": 1,
      "allowNotExecuted": [
        "ContextCoreDiArchitectureTests.ProductionComposition_Postgres_IContextStateVersionStore_ResolvesToPostgresImplementation"
      ]
    },
    {
      "job": "public-api",
      "dir": "public-api",
      "name": "public-api",
      "filter": "FullyQualifiedName~PublicApiBaselineTests",
      "minExecuted": 1,
      "allowNotExecuted": [
        "PublicApiBaselineTests.PublicApi_RegenerateBaselineFile"
      ]
    },
    {
      "job": "openapi-snapshot",
      "dir": "openapi-snapshot",
      "name": "openapi-snapshot",
      "filter": "FullyQualifiedName~OpenApiSnapshotDriftTests",
      "minExecuted": 1,
      "allowNotExecuted": [
        "OpenApiSnapshotDriftTests.OpenApi_RegenerateSnapshot"
      ]
    }
  ]
}
