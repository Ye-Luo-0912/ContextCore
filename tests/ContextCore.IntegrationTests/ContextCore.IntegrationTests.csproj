<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0-preview-24080-01" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.1.1" />
    <PackageReference Include="MSTest.TestFramework" Version="3.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.7" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.12.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ContextCore.Abstractions\ContextCore.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\ContextCore.ControlRoom\ContextCore.ControlRoom.csproj" />
    <ProjectReference Include="..\..\src\ContextCore.Core\ContextCore.Core.csproj" />
    <ProjectReference Include="..\..\src\ContextCore.Embedding\ContextCore.Embedding.csproj" />
    <ProjectReference Include="..\..\src\ContextCore.ModelGateway\ContextCore.ModelGateway.csproj" />
    <ProjectReference Include="..\..\src\ContextCore.Storage.FileSystem\ContextCore.Storage.FileSystem.csproj" />
    <ProjectReference Include="..\..\src\ContextCore.Storage.InMemory\ContextCore.Storage.InMemory.csproj" />
    <ProjectReference Include="..\..\src\ContextCore.Service\ContextCore.Service.csproj" />
    <ProjectReference Include="..\..\src\ContextCore.Storage.Postgres\ContextCore.Storage.Postgres.csproj" />
    <ProjectReference Include="..\ContextCore.Tests\ContextCore.Tests.csproj" />
    <ProjectReference Include="..\ContextCore.ProcessKillHarness\ContextCore.ProcessKillHarness.csproj" />
  </ItemGroup>

  <Target Name="CopyKillHarnessRuntimeToTestOutput" AfterTargets="Build">
    <!-- harness 是独立控制台进程，测试从测试输出目录以 dotnet &lt;dll&gt; 启动它。
         harness 的 NuGet 依赖（Microsoft.Extensions.* 等）在测试输出中会被 ASP.NET
         共享框架引用排除（不复制到本地），导致 harness 启动即 FileNotFoundException。
         这里把 harness 自身输出目录（已 CopyLocalLockFileAssemblies 自包含）整体复制过来。 -->
    <ItemGroup>
      <HarnessRuntimeFiles Include="$(MSBuildThisFileDirectory)..\ContextCore.ProcessKillHarness\bin\$(Configuration)\net10.0\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(HarnessRuntimeFiles)"
          DestinationFiles="@(HarnessRuntimeFiles->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
