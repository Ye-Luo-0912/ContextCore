{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;::1",
  "Security": {
    "RequireApiKey": true,
    "ApiKeyHeaderName": "X-ContextCore-Key",
    "ApiKey": "",
    "AllowedOrigins": [],
    // ── 多租户 Workspace 上下文 ───────────────────────────────────────
    // 控制如何从请求中解析 workspace_id（请求头 / API Key 元数据）。
    // 默认 RequireExplicitWorkspace=false：缺失时回退到 DefaultWorkspaceId（向后兼容）。
    "Workspace": {
      "WorkspaceIdHeaderName": "X-ContextCore-Workspace",
      "DefaultWorkspaceId": "",
      "RequireExplicitWorkspace": false,
      "DefaultRoleForUnauthenticated": "Viewer"
    },
    // ── RBAC（基于角色的访问控制）─────────────────────────────────────
    // Enforce=true 时 RequireWorkspaceRole/RequireWorkspacePermission 端点会拒绝无权限请求。
    // Enforce=false 时所有端点放行（仅审计日志记录，便于灰度接入）。
    "Rbac": {
      "DefaultRoles": [ "Viewer" ],
      "FallbackRolesForApiKey": [ "Developer" ],
      "RolesForStaticApiKey": [ "Admin" ],
      "Enforce": true
    },
    // ── API Key 轮换 ─────────────────────────────────────────────────
    // EnableStaticKeyRotation=true 时静态 key 也通过 IApiKeyStore 校验（支持轮换过渡期）。
    // DefaultGracePeriod=7天：轮换后旧 key 仍可校验通过 7 天，给客户端切换时间。
    "ApiKeyRotation": {
      "DefaultGracePeriod": "7.00:00:00",
      "EnableStaticKeyRotation": false,
      "PurgeInterval": "01:00:00"
    },
    // ── Approval Policy（人工审批策略）──────────────────────────────
    // Enabled=true 时 ApprovalRequiredTools 中的 Tool 调用需经过 IAgentApprovalGate 审批。
    // 默认 false：向后兼容（所有 Tool 自动通过）。
    "ApprovalPolicy": {
      "Enabled": false,
      "ApprovalRequiredTools": [ "file_delete", "shell_exec", "registry_set", "process_kill" ],
      "CostThresholdUsd": 1.0,
      "TokenThreshold": 100000,
      "WorkspaceOverrides": {}
    },
    // ── Rate Limit（限流）──────────────────────────────────────────
    // Enabled=true 时按 workspace + endpoint 维度限流（.NET 内置 RateLimiter）。
    // 默认 false：向后兼容（不限流）。
    "RateLimit": {
      "Enabled": false,
      "DefaultPolicy": {
        "Type": "TokenBucket",
        "TokenLimit": 100,
        "TokenRatePerSecond": 10,
        "QueueLimit": 0,
        "PerWorkspace": true
      },
      "WorkspacePolicies": {},
      "EndpointPolicies": {}
    },
    // ── Per-tenant Quota（按 workspace 配额）────────────────────────
    // Enabled=true 时 AgentRun 执行前检查 workspace 配额（token / cost 周期预算）。
    // 默认 false：向后兼容（无配额限制）。
    "Quota": {
      "Enabled": false,
      "DefaultLimit": {
        "MaxTokens": 0,
        "MaxCostUsd": 0,
        "Period": "01:00:00"
      },
      "WorkspaceLimits": {},
      "ExhaustionBehavior": "Reject"
    },
    // ── 审计日志保留策略 ──────────────────────────────────────────────
    // RetentionPeriod=90天：超期记录由 IAuditRetentionService 清理或归档。
    "AuditRetention": {
      "RetentionPeriod": "90.00:00:00",
      "EnableArchive": false,
      "ArchivePath": "",
      "PurgeInterval": "24:00:00"
    }
  },
  "Storage": {
    "Provider": "filesystem",
    "RootPath": "",
    "AutoBootstrap": true
  },
  // P13：模型工件根目录。RegisterModel 端点校验 ArtifactPath 必须位于此目录内
  //（或为对象存储 URI：s3:// / gs:// / az:// / https:// 等）。空值时回退到 ./model-artifacts。
  // 部署时应配置为绝对路径并确保目录存在与服务进程有读权限。
  // Perf-8：DefaultInputTensorName / DefaultScoreOutputName 为 validate / warmup / shadow /
  // activate / rollback 端点在调用方未显式提供 OnnxInferenceEngineOptions 时的默认 tensor 名。
  // 不同模型 schema 的张量名不同（常见输入名：input / features / input_ids；常见输出名：score / logits / output），
  // 应根据实际部署的模型 schema 配置；缺省回退到 "input" / "score"（与历史行为兼容）。
  "ModelArtifact": {
    "ArtifactRoot": "./model-artifacts",
    "DefaultInputTensorName": "input",
    "DefaultScoreOutputName": "score"
  },
  // P0-1：统一运行配置入口（ContextCoreRuntime）。
  // 单一配置节决定 Profile / ModelMode / AgentModelMode / ToolMode，消除旧 ProductionProfile
  // 与真实运行模式分裂问题。AddContextCoreRuntime 读取本节一次性完成所有服务注册。
  // - Profile：Development / SingleNode / ProductionHA
  // - ModelMode：Deterministic（默认）/ RealModel（需 IModelArtifactRegistry，即 Postgres provider）
  // - AgentModelMode：Deterministic（默认）/ RealModel（需调用方注册 IAgentModelTransport）
  // - ToolMode：Echo（默认）/ RealDispatch（需调用方注册 IToolDispatcher）
  // 向后兼容：若本节不存在，AddContextCoreRuntime 自动回退读取 ProductionRuntime 节。
  "ContextCoreRuntime": {
    "Profile": "Development",
    "ModelMode": "Deterministic",
    "AgentModelMode": "Deterministic",
    "ToolMode": "Echo",
    "EnableAgentKernelLoop": true,
    "EnableAgentRunRecovery": true,
    "RunRecoveryInterval": "00:01:00",
    "EnableModelActivation": false
  },
  // 旧 ProductionRuntime 配置节（保留用于向后兼容 / 测试 / ProductionRuntimeReadinessService 注入）。
  // 新代码应使用 ContextCoreRuntime 节。AddContextCoreRuntime 在 ContextCoreRuntime 节存在时忽略本节。
  "ProductionRuntime": {
    "Profile": "Development",
    "EnableAgentKernelLoop": false,
    "EnableRunRecovery": true,
    "RunRecoveryInterval": "00:01:00"
  },
  "Retrieval": {
    "AttentionRerank": {
      "Enabled": false,
      "Mode": "SelectedSetPreserving",
      "ProfileId": "old-score-anchored-v1"
    }
  },
  "Learning": {},
  "Compression": {
    "Provider": "llm"
  },
  "JobWorker": {
    "Enabled": true,
    "PollIntervalMilliseconds": 1000,
    "Concurrency": 1
  },
  "PackageTemplateCache": {
    "Enabled": false,
    "AllowedWorkspaces": [],
    "MaxEntries": 10000,
    "Ttl": null,
    "FactoryTimeout": null,
    "RequireSingleInstance": true,
    "_notes": [
      "R13-F Cache Canary Freeze：默认关闭。启用前置条件——单实例 + InMemory version store + 显式 AllowedWorkspaces。",
      "启用流程：1) 将 Enabled 设为 true；2) 在 AllowedWorkspaces 中显式列出允许缓存的工作空间 ID；3) 重启 Service。",
      "非 AllowedWorkspaces 中的工作空间仍走全量流水线（无缓存命中）——按工作空间粒度 canary。",
      "多进程检测命中时（FileSystemInstanceGuard.IsMultiProcessDetected）即使 Enabled=true 也不会启用缓存（advisory）。",
      "正确性保证由 R13.0 Cache Correctness Gate 覆盖（ContextStateCacheTests 50+ 测试）：Cold 与 Hit 等价、版本失效、对象隔离、poisoned key、shutdown 行为。"
    ]
  },
